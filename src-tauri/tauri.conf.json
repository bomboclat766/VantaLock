{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VantaLock",
  "version": "1.1.49",
  "identifier": "com.vantalock.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "../src/renderer",
    "frontendDist": "../src/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "VantaLock",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'."
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../landing-page/favicon.svg"
    ]
  }
}
